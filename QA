### FlyingPawn.cpp
```cpp
#include "FlyingPawn.h"

AFlyingPawn::AFlyingPawn()
{
    PrimaryActorTick.bCanEverTick = true;
}

void AFlyingPawn::Tick(float DeltaTime)
{
    Super::Tick(DeltaTime);
    AddActorWorldOffset(Velocity * DeltaTime, true);
}

void AFlyingPawn::SetupPlayerInputComponent(UInputComponent* PlayerInputComponent)
{
    Super::SetupPlayerInputComponent(PlayerInputComponent);
    PlayerInputComponent->BindAxis("MoveForward", this, &AFlyingPawn::MoveForward);
    PlayerInputComponent->BindAxis("MoveRight", this, &AFlyingPawn::MoveRight);
    PlayerInputComponent->BindAxis("MoveUp", this, &AFlyingPawn::MoveUp);
    PlayerInputComponent->BindAxis("Turn", this, &AFlyingPawn::Turn);
    PlayerInputComponent->BindAxis("LookUp", this, &AFlyingPawn::LookUp);
}

void AFlyingPawn::MoveForward(float Value)
{
    Velocity = GetActorForwardVector() * Value * Speed;
}

void AFlyingPawn::MoveRight(float Value)
{
    AddActorWorldOffset(GetActorRightVector() * Value * Speed * GetWorld()->GetDeltaSeconds());
}

void AFlyingPawn::MoveUp(float Value)
{
    AddActorWorldOffset(FVector::UpVector * Value * Speed * GetWorld()->GetDeltaSeconds());
}

void AFlyingPawn::Turn(float Value)
{
    AddActorWorldRotation(FRotator(0, Value * TurnRate * GetWorld()->GetDeltaSeconds(), 0));
}

void AFlyingPawn::LookUp(float Value)
{
    AddActorWorldRotation(FRotator(Value * TurnRate * GetWorld()->GetDeltaSeconds(), 0, 0));
}
